{
	"name": "tauri-jellyfin-client",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"setup:mpv:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mpv-windows.ps1",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:cov": "vitest run --coverage"
	},
	"dependencies": {
		"@jellyfin/sdk": "^0.13.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-http": "^2.8.3",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@vueuse/core": "^14.4.0",
		"lucide-vue-next": "^1.0.0",
		"node-vibrant": "^4.0.4",
		"reka-ui": "^2.10.3",
		"vue": "^3.5.13",
		"vue-router": "^4.6.4"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.3",
		"@testing-library/jest-dom": "~6.9.1",
		"@testing-library/user-event": "^14.6.8",
		"@testing-library/vue": "^8.1.0",
		"@types/node": "^26.2.0",
		"@vitejs/plugin-vue": "^5.2.1",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "^2.5.1",
		"jsdom": "^30.1.3",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"sass": "^1.102.0",
		"typescript": "~5.6.2",
		"vite": "^6.4.0",
		"vitest": "^5.0.5",
		"vue-tsc": "^2.1.10"
	}
